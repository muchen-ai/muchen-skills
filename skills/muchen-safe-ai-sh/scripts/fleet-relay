#!/usr/bin/python3 -I
import ipaddress
import os
import re
import select
import socket
import stat
import sys
from contextlib import suppress

CONFIG_DIR = "/etc/muchen-safe-ai-sh"
COMMAND_PREFIX = "muchen-fleet-connect "
ENDPOINT = re.compile(r"([0-9]{1,3}(?:\.[0-9]{1,3}){3}) ([1-9][0-9]{0,4})")
MAX_TARGETS = 256
MAX_BYTES = 8192
CONNECT_TIMEOUT = 10
CHUNK_SIZE = 65536


def parse_endpoint(text):
    match = ENDPOINT.fullmatch(text)
    if match is None:
        raise ValueError("expected an IPv4 address and port")
    address, port = match.groups()
    if str(ipaddress.IPv4Address(address)) != address or int(port) > 65535:
        raise ValueError("expected a canonical IPv4 address and valid port")
    return address, int(port)


def require_trusted(fd, file_type):
    info = os.fstat(fd)
    if not file_type(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError("fleet configuration must be root-owned and protected from other writers")


def read_targets():
    flags = os.O_RDONLY | os.O_NOFOLLOW
    directory = os.open(CONFIG_DIR, flags | os.O_DIRECTORY)
    try:
        require_trusted(directory, stat.S_ISDIR)
        fd = os.open("fleet-targets", flags | os.O_NONBLOCK, dir_fd=directory)
        with os.fdopen(fd, "rb") as file:
            require_trusted(file.fileno(), stat.S_ISREG)
            content = file.read(MAX_BYTES + 1)
    finally:
        os.close(directory)

    if len(content) > MAX_BYTES:
        raise ValueError("fleet-targets exceeds {} bytes".format(MAX_BYTES))

    targets = []
    for number, line in enumerate(content.decode("ascii").split("\n"), 1):
        if not line:
            continue
        if len(targets) >= MAX_TARGETS:
            raise ValueError("fleet-targets exceeds {} entries".format(MAX_TARGETS))
        try:
            targets.append(parse_endpoint(line))
        except ValueError:
            raise ValueError("invalid fleet target on line {}".format(number)) from None
    return targets


def relay(connection):
    os.set_blocking(0, False)
    os.set_blocking(1, False)
    connection.setblocking(False)
    upstream = connection.fileno()
    stdin_open = True
    upstream_open = True
    to_upstream = b""
    to_stdout = b""

    # Read a new chunk only after the previous chunk in that direction drains.
    while stdin_open or upstream_open or to_upstream or to_stdout:
        reads = []
        writes = []
        if stdin_open and not to_upstream:
            reads.append(0)
        if upstream_open and not to_stdout:
            reads.append(upstream)
        if to_upstream:
            writes.append(upstream)
        if to_stdout:
            writes.append(1)
        readable, writable, _ = select.select(reads, writes, [])

        if 0 in readable:
            with suppress(BlockingIOError):
                to_upstream = os.read(0, CHUNK_SIZE)
                if not to_upstream:
                    stdin_open = False
                    connection.shutdown(socket.SHUT_WR)
        if upstream in writable:
            with suppress(BlockingIOError):
                to_upstream = to_upstream[connection.send(to_upstream):]
        if upstream in readable:
            with suppress(BlockingIOError):
                to_stdout = connection.recv(CHUNK_SIZE)
                if not to_stdout:
                    upstream_open = False
                    # OpenSSH waits for both output streams before sending channel EOF.
                    os.close(1)
                    os.close(2)
        if 1 in writable:
            with suppress(BlockingIOError):
                to_stdout = to_stdout[os.write(1, to_stdout):]


def main():
    try:
        command = os.environ.get("SSH_ORIGINAL_COMMAND", "")
        if not command.startswith(COMMAND_PREFIX):
            raise ValueError("invalid relay command")
        endpoint = parse_endpoint(command[len(COMMAND_PREFIX):])
        if endpoint not in read_targets():
            raise ValueError("requested endpoint is outside fleet-targets")

        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as connection:
            connection.settimeout(CONNECT_TIMEOUT)
            connection.connect(endpoint)
            relay(connection)
    except (OSError, ValueError) as error:
        with suppress(OSError):
            print("fleet-relay: {}".format(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
