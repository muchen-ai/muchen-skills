#!/bin/sh
set -eu
PATH=/usr/bin:/bin
export PATH
export LC_ALL=C

printf 'muchen-safe-ai-sh diagnostic\n'
printf 'time_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf 'host=%s\n' "$(uname -n)"
printf 'kernel=%s\n' "$(uname -r)"
printf 'load='
cut -d ' ' -f 1-3 /proc/loadavg
awk '/^(MemTotal|MemAvailable):/ { print }' /proc/meminfo
printf 'root_filesystem:\n'
timeout 5s df -Pk /

/usr/bin/python3 -I - <<'PY'
import ipaddress
import os
import re
import socket
import stat
import sys

MAX_BYTES = 1024
MAX_PROBES = 8
TIMEOUT = 2


def require_trusted(fd, file_type):
    info = os.fstat(fd)
    if not file_type(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError("configuration must be root-owned and protected from other writers")


def read_probes():
    flags = os.O_RDONLY | os.O_NOFOLLOW
    try:
        directory = os.open("/etc/muchen-safe-ai-sh", flags | os.O_DIRECTORY)
    except FileNotFoundError:
        return []
    try:
        require_trusted(directory, stat.S_ISDIR)
        try:
            fd = os.open("tcp-probes", flags | os.O_NONBLOCK, dir_fd=directory)
        except FileNotFoundError:
            return []
        with os.fdopen(fd, "rb") as file:
            require_trusted(file.fileno(), stat.S_ISREG)
            content = file.read(MAX_BYTES + 1)
    finally:
        os.close(directory)
    if len(content) > MAX_BYTES:
        raise ValueError("configuration exceeds 1024 bytes")

    probes = []
    for number, line in enumerate(content.decode("ascii").splitlines(), 1):
        fields = line.split()
        if not fields:
            continue
        if len(probes) >= MAX_PROBES:
            raise ValueError("configuration exceeds 8 probes")
        if len(fields) != 2 or "%" in fields[0] or not re.fullmatch(r"[0-9]{1,5}", fields[1]):
            raise ValueError("expected a numeric IP and port on line {}".format(number))
        try:
            address = ipaddress.ip_address(fields[0])
        except ValueError:
            raise ValueError("invalid numeric IP on line {}".format(number)) from None
        port = int(fields[1])
        if not 1 <= port <= 65535:
            raise ValueError("invalid TCP port on line {}".format(number))
        probes.append((address, port))
    return probes


try:
    probes = read_probes()
except (OSError, ValueError) as error:
    print("tcp-probes: {}".format(error), file=sys.stderr)
    sys.exit(1)

for address, port in probes:
    ipv6 = address.version == 6
    family = socket.AF_INET6 if ipv6 else socket.AF_INET
    endpoint = "[{}]:{}".format(address, port) if ipv6 else "{}:{}".format(address, port)
    try:
        with socket.socket(family, socket.SOCK_STREAM) as connection:
            connection.settimeout(TIMEOUT)
            connection.connect((str(address), port))
        status = "reachable"
    except OSError:
        status = "unreachable"
    print("tcp_probe={} {}".format(endpoint, status))
PY
