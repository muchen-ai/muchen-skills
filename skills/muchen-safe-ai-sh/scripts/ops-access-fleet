#!/usr/bin/python3 -I
"""Issue one temporary Ed25519 SSH certificate for the fleet root principal."""

import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
import time

STATE = Path('/etc/muchen-safe-ai-sh')
TRUST = '/usr/local/libexec/muchen-safe-ai-sh/fleet-trust'
PRINCIPAL = 'muchen-fleet-root'
MAX_SERIAL = (1 << 64) - 1
USAGE = 'Usage: ops-access-fleet [30m|45m|2h] | ops-access-fleet revoke'


def protected(path, file_type, forbidden_mode):
    details = path.lstat()
    if (not file_type(details.st_mode) or details.st_uid != os.geteuid()
            or details.st_mode & forbidden_mode):
        raise ValueError('Unsafe ownership or permissions: {}'.format(path))
    return details


def public_key_fields(data, label):
    lines = data.splitlines()
    fields = lines[0].split() if len(lines) == 1 else []
    if len(fields) < 2 or fields[0] != b'ssh-ed25519':
        raise ValueError('{} must contain exactly one Ed25519 public key'.format(label))
    return fields[:2]


def keygen(*args):
    result = subprocess.run(
        ['/usr/bin/ssh-keygen', *map(str, args)],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C', 'TZ': 'UTC0', 'SSH_ASKPASS_REQUIRE': 'never'},
        start_new_session=True,
    )
    if result.returncode:
        raise ValueError(result.stderr.decode('utf-8', errors='replace').strip() or 'ssh-keygen failed')
    return result.stdout


def lifetime(args):
    if not args:
        return 1800
    match = re.fullmatch(r'([1-9][0-9]{0,2})(m|h)', args[0]) if len(args) == 1 else None
    if not match:
        raise ValueError(USAGE)
    seconds = int(match[1]) * (60 if match[2] == 'm' else 3600)
    if seconds > 7200:
        raise ValueError('Maximum lifetime is 2h')
    return seconds


def read_grants(path):
    try:
        protected(path, stat.S_ISREG, 0o077)
    except FileNotFoundError:
        return {}
    grants = json.loads(path.read_text(encoding='utf-8'))
    if (not isinstance(grants, dict)
            or any(not re.fullmatch(r'[1-9][0-9]{0,19}', serial)
                   or int(serial) > MAX_SERIAL or not isinstance(record, dict)
                   for serial, record in grants.items())):
        raise ValueError('Invalid fleet grant records')
    return grants


def issue(seconds, work, serial):
    ca = STATE / 'fleet-ca'
    if stat.S_IMODE(protected(ca, stat.S_ISREG, 0o077).st_mode) != 0o600:
        raise ValueError('fleet-ca must have mode 0600')
    ca_pub = STATE / 'fleet-ca.pub'
    enrolled = STATE / 'fleet-client.pub'
    for path in (ca_pub, enrolled):
        protected(path, stat.S_ISREG, 0o022)
    if public_key_fields(keygen('-y', '-f', ca), 'fleet-ca') != public_key_fields(
            ca_pub.read_bytes(), 'fleet-ca.pub'):
        raise ValueError('fleet-ca and fleet-ca.pub do not match')
    fields = public_key_fields(enrolled.read_bytes(), 'fleet-client.pub')
    client = work / 'client.pub'
    client.write_bytes(b' '.join(fields) + b'\n')
    starts = int(time.time())
    expires = starts + seconds
    # Older OpenSSH uses the subprocess timezone for numeric date strings.
    validity = ':'.join(time.strftime('%Y%m%d%H%M%S', time.gmtime(epoch))
                        for epoch in (starts, expires))
    key_id = '{}-{}'.format(PRINCIPAL, serial)
    principals = '{},muchen-fleet-jump-{}'.format(PRINCIPAL, serial)
    keygen('-q', '-s', ca, '-I', key_id, '-n', principals, '-z', serial,
           '-V', validity, '-O', 'clear', '-O', 'permit-pty', client)
    lines = (work / 'client-cert.pub').read_text(encoding='ascii').splitlines()
    if len(lines) != 1 or not lines[0].startswith('ssh-ed25519-cert-v01@openssh.com '):
        raise ValueError('Unexpected certificate output')
    return lines[0], {
        'key_id': key_id,
        'issued_at': starts,
        'expires_at': expires,
        'issued_by': os.environ.get('SUDO_USER') or 'root',
    }


def update_jump(lock, *args):
    # Keep the issuer lock held if the signer exits while trust is being updated.
    subprocess.run([TRUST, *args], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                   env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'},
                   pass_fds=(lock.fileno(),), check=True)


def execute(seconds):
    protected(STATE, stat.S_ISDIR, 0o022)
    lock_path = STATE / '.fleet-grant.lock'
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lock_fd, 'r+') as lock:
        protected(lock_path, stat.S_ISREG, 0o077)
        fcntl.flock(lock, fcntl.LOCK_EX)
        if seconds is None:
            update_jump(lock, 'revoke-jump')
            return
        ledger = STATE / 'fleet-grants.json'
        grants = read_grants(ledger)
        serial = max((int(previous) for previous in grants), default=0) + 1
        if serial > MAX_SERIAL:
            raise ValueError('Certificate serial numbers exhausted')
        with tempfile.TemporaryDirectory(prefix='.fleet-grant-', dir=str(STATE)) as directory:
            work = Path(directory)
            certificate, grants[str(serial)] = issue(seconds, work, serial)
            staged = work / 'fleet-grants.json'
            with staged.open('x') as out:
                json.dump(grants, out, indent=2)
                out.write('\n')
                out.flush()
                os.fsync(out.fileno())
            os.replace(staged, ledger)
            state_fd = os.open(STATE, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(state_fd)
            finally:
                os.close(state_fd)
        update_jump(lock, 'jump', str(serial))
        print(certificate, flush=True)


def main(args):
    if args in (['-h'], ['--help']):
        print(USAGE)
        return 0
    if os.geteuid() != 0:
        print('ops-access-fleet: run as an administrator via sudo', file=sys.stderr)
        return 1
    os.umask(0o077)
    try:
        execute(None if args == ['revoke'] else lifetime(args))
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print('ops-access-fleet: {}'.format(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
